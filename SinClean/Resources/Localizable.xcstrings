      }
    },
    "只做一件事": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One Recoverable Action"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只做一件事"
          }
        }
      }
    },
    "只分析明确选择的目录；系统盘、卷根和符号链接不纳入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only explicitly selected directories are analyzed; the system disk, volume roots, and symbolic links are excluded"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只分析明確選擇的目錄；系統磁碟、卷根和符號連結不納入"
          }
        }
      }
    },
    "只匹配 Bundle Identifier %@、残留类别 %@ 与完整路径同时相等的候选：%@。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches only a candidate whose Bundle Identifier %@, leftover category %@, and full path %@ all match exactly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只比對 Bundle Identifier %@、殘留類別 %@ 與完整路徑均完全相同的候選項目：%@。"
          }
        }
      }
    },
    "只匹配 Bundle Identifier 与 %@ 完全相等的应用；不匹配前缀、后缀、相似名称或大小写差异。原始应用路径记录为 %@。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches only an app whose Bundle Identifier equals %@ exactly; prefixes, suffixes, similar names, and case differences are excluded. Its original app path is %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只比對 Bundle Identifier 與 %@ 完全相同的 App；不比對前綴、後綴、相似名稱或大小寫差異。原始 App 路徑記錄為 %@。"
          }
        }
      }
    },
    "只匹配位置标识 %@ 与完整路径同时相等的候选：%@。不会匹配父目录、子目录、相似名称或大小写差异。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches only a candidate with location ID %@ and full path %@; parent directories, child directories, similar names, and case differences are excluded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只比對位置識別碼 %@ 與完整路徑均完全相同的候選項目：%@。不比對上層目錄、子目錄、相似名稱或大小寫差異。"
          }
        }
      }
    },
    "只匹配统一格式后与 %@ 完全相等的路径；不会匹配父目录、子目录、相似名称，不解析符号链接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches only the path equal to %@ after normalization; parent directories, child directories, and similar names are excluded, and symbolic links are not resolved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只比對正規化後與 %@ 完全相同的路徑；不比對上層目錄、子目錄或相似名稱，也不解析符號連結。"
          }
        }
      }
    },
    "只匹配统一格式后完整字符串相等的路径：%@。不会匹配父目录、子目录、相似名称，不解析符号链接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches only the full path %@ after normalization; parent directories, child directories, and similar names are excluded, and symbolic links are not resolved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只比對正規化後完整字串相同的路徑：%@。不比對上層目錄、子目錄或相似名稱，也不解析符號連結。"
          }
        }
      }
    },
    "只匹配统一格式后的完整路径字符串": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches only the full path string after normalization"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只匹配統一格式後的完整路徑字串"
          }
        }
      }
    },
    "只在您点击时才跳转系统设置；应用不会自动跳转": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens System Settings only when you click; the app never jumps there automatically"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在您點按時才跳轉系統設定；App 不會自動跳轉"
          }
        }
      }
    },
    "只在访达中定位，不移动文件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only locates the item in Finder; does not move the file"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在 Finder 中定位，不移動檔案"
          }
        }
      }
    },
    "只展示 Bundle Identifier 完全一致的固定路径。请确认不再需要登录状态、配置或本地数据后再勾选。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only fixed paths that exactly match the Bundle Identifier are shown. Select a leftover only after confirming you no longer need its sign-in state, settings, or local data."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只顯示與 Bundle Identifier 完全一致的固定路徑。請確認不再需要登入狀態、設定或本機資料後再勾選。"
          }
        }
      }
    },
    "只影响读取速度，不会修改任何文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only affects reading speed; no files are modified."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只影響讀取速度，不會修改任何檔案。"
          }
        }
      }
    },
    "只忽略 Bundle Identifier 完全相同的应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only ignores apps with an exactly matching Bundle Identifier"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只忽略 Bundle Identifier 完全相同的 App"
          }
        }
      }
    },
    "只改变展示，不重新扫描": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only changes the display; does not rescan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只改變顯示，不重新掃描"
          }
        }
      }
    },
    "只改变展示，不重新扫描，不选择任何项目": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only changes what is shown; does not rescan or select any items."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只改變展示，不重新掃描，不選擇任何項目"
          }
        }
      }
    },
    "只有同时满足以下条件才显示变化：两次扫描均正常完成且未取消；匿名范围标识一致（范围集合相同，顺序无关）；分类规则版本一致；容量统计口径一致；覆盖状态一致（双方都完整读取）；无整数溢出、负值或损坏记录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes are shown only when all of the following conditions are met: both scans completed normally and were not canceled; the anonymous scope identifiers match (same set of scopes, order irrelevant); the classification rules versions match; the size statistics methodology matches; the coverage status matches (both sides read in full); and there is no integer overflow, negative values, or damaged records."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有同時滿足以下條件才顯示變化：兩次掃描均正常完成且未取消；匿名範圍識別碼一致（範圍集合相同，順序無關）；分類規則版本一致；容量統計口徑一致；涵蓋狀態一致（雙方都完整讀取）；無整數溢位、負值或損毀記錄。"
          }
        }
      }
    },
    "只有在用户明确确认卸载后，应用本体才会进入卸载计划；执行前仍会复验应用身份和路径，且只会移动到废纸篓。应用本体处理失败时，全部残留保持不动。查看证据本身不会选择、忽略、卸载或移动任何项目。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app enters the uninstall plan only after you explicitly confirm. Before execution, its identity and path are checked again, and it can only be moved to the Trash. If moving the app fails, all leftovers remain untouched. Viewing evidence does not select, ignore, uninstall, or move anything."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在使用者明確確認解除安裝後，App 本體才會進入解除安裝計畫；執行前仍會再次核對 App 身分與路徑，且只會移到垃圾桶。若 App 本體處理失敗，所有殘留項目都保持不動。查看證據不會選取、忽略、解除安裝或移動任何項目。"
          }
        }
      }
    },
    "只有在真的需要时才申请权限，拒绝也能继续用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions are requested only when needed; you can continue if you decline."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在確實需要時才會要求權限；即使拒絕也能繼續使用。"
          }
        }
      }
    },
    "只查看说明，不重新扫描，不选择任何项目": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only shows the explanation; does not rescan or select any items"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只檢視說明，不重新掃描，不選擇任何項目"
          }
        }
      }
    },
    "只检查 Bundle Identifier 完全一致的固定路径": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check only fixed paths with an exactly matching Bundle Identifier"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只檢查 Bundle Identifier 完全相同的固定路徑"
          }
        }
      }
    },
    "只清空内存中的分析结果，不会访问或删除目录内容": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only clears the analysis results in memory; does not access or delete directory contents."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只清空記憶體中的分析結果，不會存取或刪除目錄內容"
          }
        }
      }
    },
    "只清空当前会话中的范围配置，不会访问或删除目录内容": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the scope configuration for this session only; directory contents are not accessed or deleted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅清空目前會話中的範圍設定，不會存取或刪除目錄內容"
          }
        }
      }
    },
    "只清空选择，不移动任何文件": {
      "localizations": {
