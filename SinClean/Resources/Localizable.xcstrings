          "stringUnit": {
            "state": "translated",
            "value": "無法預測未來的容量變化。"
          }
        }
      }
    },
    "不适用；本项不进入执行计划": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not applicable; this item is excluded from the execution plan"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不適用；本項不進入執行計畫"
          }
        }
      }
    },
    "与上次可比扫描相比": {
