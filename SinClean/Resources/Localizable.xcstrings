    "%@ 个云端占位条目尚未下载：当前不占用空间，逻辑大小合计 %@，下载后会占用更多空间": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud placeholders not downloaded: %@; they currently use no space. Combined logical size: %@. Downloading them will use more space."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 個雲端佔位條目尚未下載：目前不佔用空間，邏輯大小合計 %@，下載後會佔用更多空間"
          }
        }
      }
    },
    "%@ 个目录因权限或访问限制未统计": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Directories not counted because of permissions or access limits: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 個目錄因權限或訪問限制未統計"
          }
        }
      }
    },
    "%@ 个目录未能完成统计；授权或调整访问条件后可重新扫描，覆盖情况以实际扫描结果为准。回到本应用时会自动重新检测权限状态（也可点「%@」）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ directories could not be fully counted. After granting access or adjusting access conditions you can scan again; coverage always follows the actual scan result. Returning to this app re-checks permission status automatically (or select “%@”)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 個目錄未能完成統計；授權或調整存取條件後可重新掃描，覆蓋情況以實際掃描結果為準。回到本應用時會自動重新檢測權限狀態（也可點「%@」）。"
          }
        }
      }
    },
    "%@ 个范围未能完整核对": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopes Not Fully Checked: %@"
