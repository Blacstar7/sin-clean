            "state": "translated",
            "value": "與上次可比掃描相比"
          }
        }
      }
    },
    "两次扫描如何判定为可以公平比较": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Two Scans Are Determined to Be Comparable"
          }
        },
