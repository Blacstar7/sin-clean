        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各類別合計與掃描統計總量不一致，為避免誤導，本輪不顯示分類數字。可以重新掃描後再看診斷。"
          }
        }
      }
    },
    "各类别统计与上次可比扫描持平，未发现增长或缩小的类别": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Category statistics are unchanged from the last comparable scan; no growing or shrinking categories were found"
          }
        },
        "zh-Hant": {
