          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快取與日誌"
          }
        }
      }
    },
    "缓存与日志由 macOS 与应用自行再生。建议在原应用或系统内管理；Sin Clean 不会代为清理。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches and logs are regenerated by macOS and apps. Manage them in the original app or system; Sin Clean does not clean them on your behalf."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快取與日誌由 macOS 與 App自行再生。建議在原 App或系統內管理；Sin Clean 不會代為清理。"
          }
        }
      }
    },
    "缩小最多的类别": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories with the Most Decrease"
          }
        },
        "zh-Hant": {
