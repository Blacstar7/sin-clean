          "stringUnit": {
            "state": "translated",
            "value": "App bundle plus %@ selected leftovers, approximately %@ total. Path summary: %@. If moving the app fails, all associated files remain untouched."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 本體 + %@ 項已勾選殘留，共約 %@。路徑摘要：%@。App 本體失敗時，關聯檔案會全部保留。"
