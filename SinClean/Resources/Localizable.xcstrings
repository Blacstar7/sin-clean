            "value": "Missing Bundle Identifier"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少 Bundle Identifier"
          }
        }
      }
    },
    "缺少 Bundle Identifier，无法进行可解释的残留与关联分析。可以继续查看应用信息，但卸载按钮已关闭。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a Bundle Identifier, interpretable leftover and association analysis is unavailable. You can still view app information, but the uninstall button is disabled."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少 Bundle Identifier，無法對殘留項目與關聯作出可解釋的分析。仍可查看 App 資訊，但解除安裝按鈕已停用。"
          }
        }
      }
    },
    "网络传输失败：%@": {
      "localizations": {
        "en": {
