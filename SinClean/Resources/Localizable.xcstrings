    "Bundle Identifier 不符合安全规则，已安全跳过。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle Identifier does not meet the safety rules; skipped safely."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle Identifier 不符合安全規則，已安全跳過。"
          }
        }
      }
    },
    "Bundle Identifier 复读不一致": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle Identifier Changed on Recheck"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新讀取的 Bundle Identifier 不一致"
          }
        }
