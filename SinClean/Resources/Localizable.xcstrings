    "两项可选权限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two Optional Permissions"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩項可選權限"
          }
        }
      }
    },
    "两项权限均为可选，只在相关操作时申请；拒绝不影响其他功能。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both permissions are optional and are only requested during related operations; declining them does not affect other features."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩項權限均為可選，只在相關操作時申請；拒絕不影響其他功能。"
          }
        }
      }
    },
    "个人文件夹": {
