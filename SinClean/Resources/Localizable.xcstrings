          }
        }
      }
    },
    "扫描不会启动、退出、移动或修改任何应用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning will not launch, quit, move, or modify any app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描不會啟動、結束、移動或修改任何 App。"
          }
        }
      }
    },
    "扫描位置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Locations"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描位置"
          }
        }
      }
    },
    "扫描位置进度": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan location progress"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描位置進度"
          }
        }
      }
    },
    "扫描前后目录集合与文件元数据（占用块数、inode、链接数、容量、纳秒修改时间）零变化；源码中没有写入或删除调用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The directory contents and file metadata (allocated blocks, inode, link count, size, and nanosecond modification time) do not change across a scan; the source has no write or delete calls."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描前後的目錄集合與檔案中繼資料（佔用區塊數、inode、連結數、容量、奈秒修改時間）皆未變更；原始碼中沒有寫入或刪除呼叫。"
          }
        }
      }
    },
    "扫描只读取元数据。扫描后由您逐项勾选，并在二次确认后移到废纸篓；不会永久删除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning reads only metadata. You select items individually after scanning, and they move to the Trash only after a second confirmation; nothing is permanently deleted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描只讀取中繼資料。掃描後由您逐項勾選，並在二次確認後移到垃圾桶；不會永久刪除。"
          }
        }
      }
    },
    "扫描只读取应用包和关联路径的元数据。大型应用的容量统计可能需要几秒钟。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning only reads metadata from app bundles and associated paths. Measuring the size of large apps may take a few seconds."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描只讀取 App 套件與關聯路徑的詮釋資料。大型 App 的容量統計可能需要幾秒鐘。"
          }
        }
      }
    },
    "扫描只读取目录与文件的元数据，不移动、不删除、不修改任何文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning reads only directory and file metadata; it does not move, delete, or modify any files."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描只讀取目錄與檔案的中繼資料，不會移動、刪除或修改任何檔案。"
          }
        }
      }
    },
    "扫描后逐项选择；确认后移入废纸篓。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select items one by one after scanning; move them to the Trash after confirmation."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描後逐項選取；確認後移到垃圾桶。"
          }
        }
      }
