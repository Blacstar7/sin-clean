    "手动处理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual Handling"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動處理"
          }
        }
      }
    },
    "手动处理列表为空": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual handling list is empty"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動處理列表為空"
          }
        }
      }
    },
    "手动处理只把您逐项选择的项目移入系统废纸篓；不提供永久删除、全选或批量清空，也不会在分析或选择阶段移动任何文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual Handling moves only items you select individually to the system Trash. It does not offer permanent deletion, Select All, or bulk emptying, and does not move files during analysis or selection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動處理只會將您逐項選取的項目移到系統垃圾桶；不提供永久刪除、全選或批次清空，分析或選取時也不會移動任何檔案。"
          }
        }
      }
    },
    "手动处理审阅摘要": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual handling review summary"
          }
        },
