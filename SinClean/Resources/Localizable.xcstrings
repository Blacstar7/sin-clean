            "value": "下載的安裝套件"
          }
        }
      }
    },
    "不上传任何数据。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No data is uploaded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不上傳任何資料。"
          }
        }
      }
    },
    "不会因为文件名含有应用名称就判定为残留；所有残留默认不勾选。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file is not classified as a leftover merely because its name contains the app name; no leftovers are selected by default."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會只因檔名含有 App 名稱就判定為殘留項目；所有殘留項目預設不勾選。"
          }
        }
      }
    },
    "不会扫描": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Scanned"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會掃描"
          }
        }
      }
    },
    "不会改变系统电源策略，也不会清理任何数据。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not change system power policy or clean any data."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會變更系統電源策略，也不會清理任何資料。"
          }
        }
      }
    },
    "不会清理磁盘空间，也不会删除任何文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not clean disk space or delete any files."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會清理磁碟空間，也不會刪除任何檔案。"
          }
        }
      }
    },
    "不会结束任何进程，也不会清理缓存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not end any process or clear caches."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會結束任何程序，也不會清理快取。"
          }
        }
      }
    },
    "不会自动删除任何文件；本应用只把逐项确认的项目移入废纸篓。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No files are deleted automatically; this app moves only individually confirmed items to the Trash."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會自動刪除任何檔案；本 App 只會將逐項確認的項目移到垃圾桶。"
          }
        }
      }
    },
    "不会跳过任何权限说明，也不会申请任何权限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No permission explanations will be skipped, and no permissions will be requested."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會跳過任何權限說明，也不會要求任何權限"
          }
        }
      }
    },
    "不保存任何路径、文件名、目录名、应用名或文件清单；不联网、不上传": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paths, file names, directory names, app names, or file lists are saved; no networking, no uploads"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不儲存任何路徑、檔案名稱、目錄名稱、App 名稱或檔案清單；不聯網、不上傳"
          }
        }
      }
    },
    "不保存任何路径、文件名、目录名、应用名或文件清单；不联网、不上传。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paths, file names, directory names, app names, or file lists are saved; no networking, no uploads."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不儲存任何路徑、檔案名稱、目錄名稱、App 名稱或檔案清單；不聯網、不上傳。"
          }
        }
      }
    },
    "不做会怎样：%@": {
