        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得"
          }
        }
      }
    },
    "不可访问": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaccessible"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不可存取"
          }
        }
      }
    },
    "不可读": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreadable"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不可讀"
          }
        }
      }
    },
    "不可读目录未来不会被静默计为零。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreadable directories will not silently be counted as zero."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不可讀目錄未來不會被靜默計為零。"
          }
        }
      }
    },
    "不含遥测、崩溃上报或第三方分析。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No telemetry, crash reporting, or third-party analytics."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不含遙測、崩潰上報或第三方分析。"
          }
        }
      }
    },
    "不授权也能正常使用：受保护目录不计入统计，界面会明确标注有几个目录未统计。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can continue without granting access: protected directories are excluded from the total, and the number excluded is shown."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不授權也能正常使用：受保護目錄不計入統計，介面會明確標注有幾個目錄未統計。"
          }
        }
      }
    },
    "不授权也能正常使用：提醒不会弹出，但证据卡与趋势仍然照常更新。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can continue without granting access: notifications will not appear, but evidence cards and trends will still update."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不授權也能正常使用：提醒不會彈出，但證據卡與趨勢仍然照常更新。"
          }
        }
      }
    },
    "不是可读取目录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a readable directory"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是可讀取目錄"
          }
        }
      }
    },
    "不是普通文件，按现有类型规则跳过": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a regular file; skipped under the existing type rules"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是普通檔案，按現有類型規則跳過"
          }
        }
      }
    },
    "不能代表更长时段或单个应用的表现。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not represent a longer period or the behavior of a single app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不代表較長時段或單一 App 的表現。"
          }
        }
      }
    },
    "不能解决：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot resolve: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解決：%@"
          }
        }
      }
    },
    "不能解释个别应用自身的内存占用感受。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not explain the memory usage perceived in an individual app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解釋個別 App 的記憶體使用情形。"
          }
        }
      }
    },
    "不能预测未来的容量变化。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not predict future capacity changes."
          }
        },
