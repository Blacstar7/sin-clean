          }
        }
      }
    },
    "Sin Clean 当前为内部测试构建，应用本体保持零网络，不包含联网更新检查。更新检查将随正式分发链路提供：届时仅在您主动点击时连接更新服务器一次，除此之外不产生任何网络活动。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Clean is currently an internal test build. The App Bundle maintains zero network activity and does not include online update checking. Update checking will be provided with the official distribution channel: it will connect to the update server only once, and only when you click it yourself; no other network activity will occur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Clean 目前為內部測試建置，App 本體保持零網路活動，不包含連網更新檢查。更新檢查將隨正式發行管道提供：屆時只會在您主動點按時連接更新伺服器一次，除此之外不會產生任何網路活動。"
          }
        }
      }
    },
    "Sin Clean 操作计划": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Clean Operation Plan"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Clean 操作計畫"
          }
        }
      }
    },
